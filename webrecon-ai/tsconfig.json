{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@webrecon/types": ["packages/types/src/index.ts"],
      "@webrecon/shared": ["packages/shared/src/index.ts"],
      "@webrecon/firebase/*": ["packages/firebase/src/*"],
      "@webrecon/logger": ["packages/logger/src/index.ts"],
      "@webrecon/security": ["packages/security/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
