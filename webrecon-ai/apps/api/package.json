{
  "name": "@webrecon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@webrecon/types": "workspace:*",
    "@webrecon/shared": "workspace:*",
    "@webrecon/firebase": "workspace:*",
    "@webrecon/logger": "workspace:*",
    "@webrecon/security": "workspace:*",
    "@webrecon/browser": "workspace:*",
    "@webrecon/jobs": "workspace:*",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "typescript-eslint": "^8.13.0"
  }
}
